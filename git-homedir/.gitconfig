[user]
	name = Ray Zeng
	email = zengjray@gmail.com

[alias]
	st = status
	l = log --oneline
	la = log --all --oneline --graph --decorate
	lg = log --oneline --graph --decorate
	p = push
	cm = commit
	am = commit --amend
	a = add -u
	aa = add --all
	rb = rebase
	rbi = rebase -i
	rbc = rebase --continue
	co = checkout
	br = branch
	cp = cherry-pick
	df = diff
	ds = diff --staged
	pl = pull
	f = fetch
	sw = switch
	sl = stash list
	sp = stash pop
	ss = stash show
	last = log -1 HEAD
	unstage = reset HEAD --
