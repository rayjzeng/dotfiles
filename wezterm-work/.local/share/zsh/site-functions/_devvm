#compdef devvm

local config_dir=${DEVVM_CONFIG_DIR:-$HOME/.config/wezterm}
local line host alias
local -a candidates commands fields
if [[ -r "$config_dir/devservers" ]]; then
  while IFS= read -r line || [[ -n $line ]]; do
    line=${line%%\#*}
    fields=(${=line})
    (( ${#fields} )) || continue
    host=$fields[1]
    alias=${fields[2]:-}
    candidates+=("$host:${alias:-${host%%.*}}" "${host%%.*}:$host")
    [[ -n $alias ]] && candidates+=("$alias:$host")
  done < "$config_dir/devservers"
fi
commands=(
  'init:initialize hosts from Enkaku'
  'ls:list configured hosts'
  'add:add a hostname and optional alias'
  'rm:remove a configured host'
  'detach:move a server into its own window'
  'merge:gather sessions into the main window'
  'local:switch to local tabs'
  'help:show usage'
)
if (( CURRENT == 2 )); then
  _describe -t commands 'command' commands
  _describe -t hosts 'devserver' candidates
elif (( CURRENT == 3 )); then
  case $words[2] in
    merge) candidates+=('all:all configured servers'); _describe 'devserver' candidates ;;
    detach|rm) _describe 'devserver' candidates ;;
    add) _message 'full hostname' ;;
  esac
elif (( CURRENT == 4 )) && [[ $words[2] == add ]]; then
  _message 'optional alias'
fi
