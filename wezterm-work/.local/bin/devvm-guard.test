#!/bin/bash
set -euo pipefail
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
python3 -I - "$script_dir/devvm-guard" <<'PY'
import importlib.machinery, importlib.util, json, os, socket, subprocess, sys, tempfile, threading, time
from pathlib import Path

guard_path = sys.argv[1]
# Importing the helper must not leave __pycache__ beside it for stow to link.
sys.dont_write_bytecode = True
loader = importlib.machinery.SourceFileLoader('devvm_guard', guard_path)
spec = importlib.util.spec_from_loader('devvm_guard', loader)
guard = importlib.util.module_from_spec(spec)
loader.exec_module(guard)
# /bin keeps ps reachable but hides osascript, so tests never raise notifications.
env = dict(os.environ, PATH='/bin')


def leb128(value):
    out = bytearray()
    while True:
        byte = value & 0x7F
        value >>= 7
        out.append(byte | (0x80 if value else 0))
        if not value:
            return bytes(out)


def frame(ident, payload=b'', serial=0, compressed=False):
    body = leb128(serial) + leb128(ident) + payload
    length = len(body) | ((1 << 63) if compressed else 0)
    return leb128(length) + body


def wait_for(check, what, timeout=10):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if check():
            return
        time.sleep(0.05)
    raise AssertionError('timed out: ' + what)


# Frame counting survives arbitrary chunk boundaries, large and compressed payloads.
stream = (frame(53) + frame(24, b'x' * 200_000) + frame(53, b'\x01', serial=300)
          + frame(45) + frame(53, b'y' * 70_000, compressed=True))
for chunk in (1, 2, 7, 4096, len(stream)):
    counter = guard.PduCounter({53})
    for i in range(0, len(stream), chunk):
        counter.feed(stream[i:i + chunk])
    assert counter.hits == 3 and not counter.lost_sync, (chunk, counter.hits)
print('PASS: PDU counter tracks focus frames across chunk boundaries and payload sizes')


def pane(tab, pane_id, left, top, cols, rows):
    return {'tab_id': tab, 'pane_id': pane_id, 'left_col': left, 'top_row': top, 'is_zoomed': False,
            'size': {'cols': cols, 'rows': rows, 'pixel_width': cols * 14, 'pixel_height': rows * 32, 'dpi': 144}}


def layout_after(panes, plan):
    """Recompute pane geometry the way the server's split tree would after a plan."""
    sizes = {p_id: (cols, rows) for _, p_id, rows, cols, *_ in plan}
    return {p['pane_id']: sizes.get(p['pane_id'], (p['size']['cols'], p['size']['rows'])) for p in panes}


# The live crash layout: three side-by-side panes totalling 1,496 columns.
live = [pane(12, 5, 0, 0, 480, 101), pane(12, 27, 481, 0, 801, 101), pane(12, 26, 1283, 0, 213, 101)]
sizes = layout_after(live, guard.fit_plan(live, 427, 99))
assert sum(cols for cols, _ in sizes.values()) + 2 == 427, sizes
assert all(rows == 99 for _, rows in sizes.values()), sizes
assert sizes[27][0] > sizes[5][0] > sizes[26][0], 'fitting must keep pane proportions'
# Left pane beside a right column split top/bottom: borders must still line up.
nested = [pane(1, 1, 0, 0, 900, 120), pane(1, 2, 901, 0, 600, 59), pane(1, 3, 901, 60, 600, 60)]
sizes = layout_after(nested, guard.fit_plan(nested, 300, 80))
assert sizes[1][0] + 1 + sizes[2][0] == 300 and sizes[2][0] == sizes[3][0], sizes
assert sizes[2][1] + 1 + sizes[3][1] == 80 and sizes[1][1] == 80, sizes
fitting = [pane(2, 4, 0, 0, 200, 50), pane(2, 5, 201, 0, 100, 50)]
assert guard.fit_plan(fitting + live, 427, 101) and not guard.fit_plan(fitting, 427, 101), \
    'tabs that already fit must be left alone'
print('PASS: fit plan shrinks oversized tabs proportionally with aligned split borders')


def guard_cli(*args):
    result = subprocess.run([sys.executable, '-I', guard_path, *map(str, args)], env=env,
                            capture_output=True, text=True, timeout=20)
    assert result.returncode == 0, result.stderr
    return result.stdout.strip()


def serve(path, on_connect):
    server = socket.socket(socket.AF_UNIX)
    server.bind(str(path))
    server.listen(16)

    def accept():
        while True:
            try:
                conn, _ = server.accept()
            except OSError:
                return
            threading.Thread(target=on_connect, args=(conn,), daemon=True).start()
    threading.Thread(target=accept, daemon=True).start()
    return server


def echo(conn):
    with conn:
        while data := conn.recv(65536):
            conn.sendall(data)


def connect(path):
    client = socket.socket(socket.AF_UNIX)
    client.connect(str(path))
    client.settimeout(5)
    return client


def closed(client):
    try:
        return client.recv(1) == b''
    except socket.timeout:
        return False
    except OSError:
        return True


with tempfile.TemporaryDirectory(prefix='devvm-guard-', dir='/tmp') as directory:
    root = Path(directory)
    state = root / 'state'
    try:
        upstream = root / 'upstream.sock'
        serve(upstream, echo)
        listen = Path(guard_cli('ensure', 'hosta', upstream, state))
        record = state / 'relays/hosta.json'
        first_pid = json.loads(record.read_text())['pid']

        client = connect(listen)
        payload = frame(24, os.urandom(300_000))
        client.sendall(payload)
        received = b''
        while len(received) < len(payload):
            received += client.recv(65536)
        assert received == payload, 'relay altered the byte stream'

        assert guard_cli('ensure', 'hosta', upstream, state) == str(listen)
        assert json.loads(record.read_text())['pid'] == first_pid, 'ensure replaced a healthy relay'
        assert (state / 'relays/hosta.connections').read_text() == '1'
        assert not closed(client), 'ensure dropped a live connection'

        guard_cli('restart', 'hosta', state)
        wait_for(lambda: closed(client), 'restart closes connections the old relay carried')
        assert json.loads(record.read_text())['pid'] != first_pid
        assert listen.is_socket(), 'a stopping relay removed its successor socket'
        print('PASS: relay preserves bytes, ensure keeps live connections, restart closes stale ones')

        # Concurrent ensures must leave one relay, the recorded one, so restart can reach it.
        racers = [subprocess.Popen([sys.executable, '-I', guard_path, 'ensure', 'hostc', str(upstream), str(state)],
                                   env=env, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE) for _ in range(8)]
        for racer in racers:
            assert racer.wait(timeout=20) == 0, racer.stderr.read()
        ps = subprocess.run(['ps', '-ax', '-o', 'pid=,command='], capture_output=True, text=True).stdout
        relays = [int(line.split()[0]) for line in ps.splitlines() if 'devvm-guard relay hostc ' in line and line.endswith(f' {state}')]
        assert relays == [guard.recorded_relay(state, 'hostc')['pid']], f'unrecorded relays survived: {relays}'
        print('PASS: concurrent ensures leave exactly one recorded relay')

        # Heavy non-focus output must never trip the breaker.
        client = connect(listen)
        output = frame(25, b'z' * 60_000)
        end = time.monotonic() + guard.TRIP_AFTER_SECONDS + 1.5
        while time.monotonic() < end:
            client.sendall(output)
            got = 0
            while got < len(output):
                got += len(client.recv(65536))
        assert not (state / 'trips.log').exists(), 'bulk output tripped the focus breaker'
        client.close()
        print('PASS: sustained bulk output does not trip the focus breaker')

        # A server-side PaneFocused flood trips the relay and drops the host's connections.
        flood_upstream = root / 'flood.sock'
        def flood(conn):
            with conn:
                try:
                    while True:
                        conn.sendall(frame(53, b'\x63') * 20)
                        time.sleep(0.01)
                except OSError:
                    pass
        serve(flood_upstream, flood)
        listen = Path(guard_cli('ensure', 'hostb', flood_upstream, state))
        victim = connect(listen)
        def drain():
            try:
                while victim.recv(65536):
                    pass
            except OSError:
                pass
        threading.Thread(target=drain, daemon=True).start()
        wait_for(lambda: (state / 'trips.log').exists(), 'focus flood trips the relay',
                 timeout=guard.TRIP_AFTER_SECONDS + 5)
        trip = json.loads((state / 'trips.log').read_text().splitlines()[-1])
        assert trip['guard'] == 'relay' and trip['host'] == 'hostb', trip
        assert trip['focus_pdus_per_second'] > guard.FOCUS_PDUS_PER_SECOND
        wait_for(lambda: not listen.exists(), 'tripped relay removes its socket')
        guard_cli('ensure', 'hostb', flood_upstream, state)
        assert listen.is_socket(), 'ensure did not restart a tripped relay'
        print('PASS: focus flood trips the relay, and ensure brings it back')

        # fit shrinks real oversized tabs, including zoomed ones, without replacing panes.
        wezterm = '/Applications/WezTerm.app/Contents/MacOS/wezterm'
        mux_socket = root / 'mux/sock'
        mux_socket.parent.mkdir()
        (root / 'mux/config.lua').write_text("return {unix_domains={{name='u',socket_path=" + repr(str(mux_socket))
                                             + "}},default_prog={'/bin/sh'}}\n")
        mux = subprocess.Popen([wezterm + '-mux-server', '--config-file', str(root / 'mux/config.lua')],
                               env=dict(env, XDG_RUNTIME_DIR=str(root / 'mux')),
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        try:
            mux_env = dict(env, WEZTERM_UNIX_SOCKET=str(mux_socket))
            def mux_cli(*args):
                return subprocess.run([wezterm, '-n', 'cli', '--no-auto-start', *args], env=mux_env,
                                      capture_output=True, text=True, timeout=10)
            wait_for(lambda: mux_cli('list').returncode == 0, 'private mux server')
            def tab_panes(tab):
                return [p for p in json.loads(mux_cli('list', '--format', 'json').stdout) if p['tab_id'] == tab]
            first = int(mux_cli('spawn', '--new-window').stdout)
            second = int(mux_cli('split-pane', '--pane-id', str(first), '--right').stdout)
            third = int(mux_cli('split-pane', '--pane-id', str(second), '--bottom').stdout)
            first_row = next(p for p in json.loads(mux_cli('list', '--format', 'json').stdout) if p['pane_id'] == first)
            split_tab = first_row['tab_id']
            zoomed = int(mux_cli('spawn', '--window-id', str(first_row['window_id'])).stdout)
            mux_cli('split-pane', '--pane-id', str(zoomed), '--right')
            zoomed_tab = next(p['tab_id'] for p in json.loads(mux_cli('list', '--format', 'json').stdout)
                              if p['pane_id'] == zoomed)
            for tab in (split_tab, zoomed_tab):
                panes = tab_panes(tab)
                width = max(p['left_col'] + p['size']['cols'] for p in panes)
                guard.send_resizes(mux_socket, [(tab, p['pane_id'], p['size']['rows'],
                                                 p['size']['cols'] * 1496 // width, 0, 0, 144) for p in panes])
            mux_cli('zoom-pane', '--pane-id', str(zoomed), '--zoom')
            assert max(p['left_col'] + p['size']['cols'] for p in tab_panes(split_tab)) > 1000, 'inflation failed'
            before = {p['pane_id'] for tab in (split_tab, zoomed_tab) for p in tab_panes(tab)}
            fitted = guard_cli('fit', 'hostf', state, wezterm, mux_socket, 427, 20)
            assert f'fitted tab {split_tab} ' in fitted and f'fitted tab {zoomed_tab} ' in fitted, fitted
            fits = [json.loads(line) for line in (state / 'trips.log').read_text().splitlines()]
            fits = {f['tab'] for f in fits if f['guard'] == 'fit' and f['host'] == 'hostf'}
            assert {split_tab, zoomed_tab} <= fits, fits
            for tab in (split_tab, zoomed_tab):
                panes = tab_panes(tab)
                assert max(p['left_col'] + p['size']['cols'] for p in panes) <= 427, panes
                assert max(p['top_row'] + p['size']['rows'] for p in panes) <= 20, panes
            left, right = sorted((p for p in tab_panes(split_tab) if p['top_row'] == 0), key=lambda p: p['left_col'])
            assert right['left_col'] == left['size']['cols'] + 1, 'split borders no longer line up'
            assert {p['pane_id'] for tab in (split_tab, zoomed_tab) for p in tab_panes(tab)} == before, \
                'fitting replaced panes'
            assert [p['pane_id'] for p in tab_panes(zoomed_tab) if p['is_zoomed']] == [zoomed], \
                'fitting lost the zoom it had to undo'
            assert guard_cli('fit', 'hostf', state, wezterm, mux_socket, 427, 20) == '', 'fit touched tabs that already fit'
            print('PASS: fit shrinks oversized and zoomed server tabs in place, then leaves them alone')

            # Panes too narrow to shrink are clamped to one cell, pushing the scaled
            # layout past the limit; fit must keep going until the tab really fits.
            narrow = int(mux_cli('spawn', '--window-id', str(first_row['window_id'])).stdout)
            middle = int(mux_cli('split-pane', '--pane-id', str(narrow), '--right').stdout)
            wide = int(mux_cli('split-pane', '--pane-id', str(middle), '--right').stdout)
            uneven_tab = next(p['tab_id'] for p in json.loads(mux_cli('list', '--format', 'json').stdout)
                              if p['pane_id'] == narrow)
            guard.send_resizes(mux_socket, [(uneven_tab, pane_id, 20, cols, cols * 14, 640, 144)
                                            for pane_id, cols in ((narrow, 1), (middle, 1), (wide, 20))])
            assert sorted(p['size']['cols'] for p in tab_panes(uneven_tab)) == [1, 1, 20], tab_panes(uneven_tab)
            guard_cli('fit', 'hostf', state, wezterm, mux_socket, 20, 20)
            assert max(p['left_col'] + p['size']['cols'] for p in tab_panes(uneven_tab)) <= 20, tab_panes(uneven_tab)
            print('PASS: fit keeps refitting until tabs with clamped narrow panes fit')
        finally:
            mux.terminate()
            mux.wait()

        # The watchdog trips on a fast-growing GUI log and stops every relay.
        (state / 'trips.log').unlink()
        log_dir = root / 'logs'
        log_dir.mkdir()
        fake_gui = subprocess.Popen([sys.executable, '-I', '-c', f'''
import subprocess, sys, time, os
from pathlib import Path
log = Path({str(log_dir)!r}) / f"wezterm-gui-log-{{os.getpid()}}.txt"
log.touch()
watchdog = subprocess.Popen([sys.executable, '-I', {guard_path!r}, 'watchdog', {str(state)!r}, {str(log_dir)!r}, str(os.getpid())])
time.sleep(1)  # let the first watchdog take the lock
second = subprocess.Popen([sys.executable, '-I', {guard_path!r}, 'watchdog', {str(state)!r}, {str(log_dir)!r}, str(os.getpid())])
assert second.wait(timeout=10) == 0, 'second watchdog did not yield to the first'
line = b"ERROR wezterm_gui::frontend > Error reconciling PaneFocused notification: pane 99 not found\\n"
with open(log, 'ab') as out:
    for _ in range(80):
        out.write(line * 4000)
        out.flush()
        time.sleep(0.1)
time.sleep(30)
'''], env=env)
        try:
            wait_for(lambda: (state / 'trips.log').exists(), 'watchdog trips on log flood', timeout=20)
            trip = json.loads((state / 'trips.log').read_text().splitlines()[-1])
            assert trip['guard'] == 'watchdog' and sorted(trip['relays']) == ['hosta', 'hostb', 'hostc'], trip
            assert not guard.is_running('hosta', guard.recorded_relay(state, 'hosta'))
            assert not (state / 'relays/hosta.connections').exists(), 'stopped relay left a stale connection count'
            print('PASS: watchdog is single-instance, trips on a GUI log flood, and stops every relay')

            # A GUI started while another GUI's watchdog runs (a quick restart, or a
            # second process) must get its own watchdog, which ends with that GUI.
            successor = subprocess.Popen(['sleep', '30'])
            watcher = subprocess.Popen([sys.executable, '-I', guard_path, 'watchdog', str(state), str(log_dir),
                                        str(successor.pid)], env=env)
            try:
                time.sleep(2)
                assert watcher.poll() is None, 'watchdog abandoned a GUI because another GUI was watched'
                successor.kill()
                successor.wait()
                assert watcher.wait(timeout=5) == 0
                assert not (state / f'watchdogs/{successor.pid}.lock').exists(), 'watchdog left its lock behind'
                print('PASS: each GUI gets its own watchdog, which exits and cleans up with its GUI')
            finally:
                successor.kill()
                watcher.kill()
        finally:
            fake_gui.kill()
            fake_gui.wait()

        # A relay that exits between the liveness check and the kill must not abort
        # shutdown, and shutdown must wait out a replacement holding the host's lock.
        guard_cli('ensure', 'raceb', upstream, state)
        exited = subprocess.Popen(['true'])
        exited.wait()
        (state / 'relays/racea.json').write_text(json.dumps({'pid': exited.pid, 'upstream': str(upstream)}))
        checked = guard.is_running
        guard.is_running = lambda host, relay: host == 'racea' or checked(host, relay)
        replacing = guard.lock_host(state, 'raceb')
        stopped = []
        shutdown = threading.Thread(target=lambda: stopped.extend(guard.stop_relays(state)))
        try:
            shutdown.start()
            time.sleep(0.5)
            assert checked('raceb', guard.recorded_relay(state, 'raceb')), 'shutdown ignored a held host lock'
            replacing.close()
            shutdown.join(timeout=10)
        finally:
            guard.is_running = checked
        assert stopped == ['racea', 'raceb'], stopped
        assert not checked('raceb', guard.recorded_relay(state, 'raceb')), 'a racing exit aborted shutdown'
        print('PASS: shutdown tolerates relays that exit mid-stop and waits for in-progress replacements')
    finally:
        for record in (state / 'relays').glob('*.json'):
            guard.stop_relay(state, record.stem)
PY
